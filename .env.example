# Safe local-shell example. No credentials are required for deterministic reporting.
# The app does not load this file automatically. See README section 11.
# Backend defaults; the frontend command overrides PORT to 5173.
PORT=5000
BASE_PATH=/

# Optional absolute locations; omit to use repository defaults.
# VIREO_DATA_DIR=/absolute/path/to/authorized-data
# VIREO_CACHE_PATH=/absolute/path/to/vireo-cache/insights.sqlite3

# Optional executable/private port overrides.
# VIREO_PYTHON=/absolute/path/to/python3
# VIREO_ANALYTICS_PORT=18765

# Choose ONE provider configuration only. Keep real keys out of Git.
# Managed Replit configuration is normally provisioned in the environment:
# AI_INTEGRATIONS_OPENAI_BASE_URL=https://your-managed-provider.example/v1
# AI_INTEGRATIONS_OPENAI_API_KEY=replace-with-your-managed-key

# Alternatively, use an external OpenAI-compatible provider:
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=replace-with-your-own-provider-key

# Optional model override. The chosen provider must support the chosen model.
# Current managed default: gpt-5.4-mini
# VIREO_AI_MODEL=replace-with-a-provider-supported-model